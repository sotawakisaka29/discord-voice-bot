{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voice-recording-site",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "RECORDINGS_BUCKET",
			"bucket_name": "voice-recordings"
		}
	]
}
